CompileFlags:
  CompilationDatabase: Build
  Compiler: clang-cl
  Remove: ['/Zi', '/ZI', '/Z7', '/FS', '/JMC', '/analyze']
Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict
Index:
  Background: Build
Hover:
  ShowAKA: true
InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
